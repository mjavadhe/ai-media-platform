# Copy to .env and adjust. NEVER commit real secrets.
APP_ENVIRONMENT=development
APP_DEBUG=false

# PostgreSQL (asyncpg driver required)
APP_DATABASE_URL=postgresql+asyncpg://ai_media:ai_media@localhost:5432/ai_media

# Auth — replace in any non-local environment
APP_SECRET_KEY=dev-insecure-change-me
APP_COOKIE_SECURE=false

# GPU backend: auto | mock | nvml
APP_GPU_BACKEND=mock
APP_MOCK_GPU_NODES=1
APP_MOCK_GPUS_PER_NODE=2
APP_MOCK_GPU_VRAM_MB=11000

# Storage
APP_STORAGE_BACKEND=local
APP_STORAGE_ROOT=./var/storage
APP_STORAGE_BUCKET=ai-media

# Scheduler / lease
APP_SCHEDULER_ENABLED=true
APP_ORCHESTRATOR_ENABLED=true
APP_LEASE_TTL_SECONDS=60
APP_HEARTBEAT_INTERVAL_SECONDS=10
APP_JOB_MAX_RETRIES=3

# Worker (used by the standalone worker process)
APP_WORKER_BASE_URL=http://localhost:8000
APP_WORKER_NAME=worker-local
APP_WORKER_EXECUTION_BACKEND=mock

# Frontend origin allowed by CORS
APP_CORS_ORIGINS=["http://localhost:5173"]
